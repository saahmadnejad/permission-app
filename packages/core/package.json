{
  "name": "permission-visibility-core",
  "version": "0.1.0",
  "description": "Framework-free permission visibility engine: query language, hierarchical visibility rule, fail-closed stores, node registry, route-guard helpers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "keywords": [
    "permissions",
    "authorization",
    "access-control",
    "rbac",
    "visibility",
    "ui",
    "frontend",
    "framework-agnostic",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saahmadnejad/permission-app.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/saahmadnejad/permission-app/issues"
  },
  "homepage": "https://github.com/saahmadnejad/permission-app#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --test-reporter=spec dist-test/test",
    "pretest": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
